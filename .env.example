# API keys
# OpenRouter serves both the vision model and the embedding model.
OPENROUTER_API_KEY=your-openrouter-api-key

# Models (OpenRouter model IDs)
# The vision model must accept image input.
VISION_MODEL=z-ai/glm-5.3-flash
EMBEDDING_MODEL=openai/text-embedding-3-small
# Vector size from EMBEDDING_MODEL. Must match the Qdrant collection.
EMBEDDING_DIMENSIONS=1536

# OpenRouter (optional, default shown)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Qdrant (optional, defaults shown)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=images

# Frontend: where Next.js proxies /api and /images
BACKEND_URL=http://localhost:8000
